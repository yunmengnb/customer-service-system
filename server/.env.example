# 忆梦云团队开发
PORT=3000
NODE_ENV=development

# MongoDB 连接
MONGO_URI=mongodb://localhost:27017/customer_service

# Redis（可选；留空时自动降级为单进程内存实现）
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_CACHE_TTL_SECONDS=300

# 个推（留空时安全禁用推送；MasterSecret 仅允许配置在服务端）
GETUI_APP_ID=
GETUI_APP_KEY=
GETUI_MASTER_SECRET=
GETUI_BASE_URL=https://restapi.getui.com/v2
GETUI_TIMEOUT_MS=8000
GETUI_TTL_MS=7200000
GETUI_HIDE_MESSAGE_CONTENT=false

# JWT 密钥（生产环境必须更换为随机长字符串）
JWT_SECRET=change_me_to_a_long_random_string_for_production
JWT_EXPIRES_IN=7d

# CORS 允许的来源（逗号分隔）
CORS_ORIGIN=http://localhost:5174,http://localhost:5175,http://localhost:5176

# 默认管理员账号
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@example.com

# 默认租户
DEFAULT_TENANT_NAME=示例企业
DEFAULT_TENANT_USERNAME=demo
DEFAULT_TENANT_PASSWORD=demo123
